{
  "manifest_version": 3,
  "name": "Tab Mover & Merger",
  "version": "1.1.0",
  "description": "Move tabs by domain to a new window or merge all windows easily.",
  "permissions": [
    "tabs",
    "contextMenus",
    "windows"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}